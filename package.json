{
  "name": "aurora",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11.6"
  },
  "scripts": {
    "start": "expo start",
    "ios": "npm run ios:open",
    "ios:bootstrap": "bash scripts/bootstrap-ios.sh",
    "ios:pods": "npm run ios:bootstrap",
    "ios:open": "open ios/AURORA.xcworkspace",
    "ios:build:debug": "xcodebuild -workspace ios/AURORA.xcworkspace -scheme AURORA -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -derivedDataPath ios/build/DerivedData CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO build",
    "ios:build:release": "xcodebuild -workspace ios/AURORA.xcworkspace -scheme AURORA -configuration Release -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -derivedDataPath ios/build/DerivedData CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO build",
    "site:dev": "npm --prefix website run dev",
    "site:build": "npm --prefix website run build",
    "site:type-check": "npm --prefix website run type-check",
    "contrib:grid": "node scripts/starry-night-grid.js",
    "contrib:plan": "node scripts/starry-night-grid.js plan",
    "contrib:paint": "node scripts/paint-contribs.js",
    "test": "jest",
    "lint": "eslint . --ext .ts,.tsx",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.4.6",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.3.25",
    "date-fns": "^3.6.0",
    "expo": "~54.0.35",
    "expo-asset": "~12.0.13",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-notifications": "~0.32.17",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-health": "^1.19.0",
    "react-native-mmkv": "^3.3.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-worklets": "^0.5.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.1.10",
    "babel-plugin-module-resolver": "^5.0.0",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^9.6.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.35.0",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "jest-expo": "^54.0.17",
    "prettier": "^3.3.3",
    "sharp": "^0.34.3",
    "test-renderer": "^1.2.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.41.0"
  },
  "overrides": {
    "@expo/fingerprint": "0.15.0"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-health"
        ]
      },
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
}
